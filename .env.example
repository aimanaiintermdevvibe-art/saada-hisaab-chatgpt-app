# ---------- Database ----------
PG_HOST=localhost
PG_PORT=5432
DB_NAME=sadahisab_db

# Superuser: used ONLY by the setup scripts in db/ (create DB, restore, create roles).
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=

# Read-only login the MCP server uses. It can SELECT, nothing else.
# On Supabase's connection pooler add the project ref: sh_mcp_readonly.<project-ref>
DB_READONLY_USER=sh_mcp_readonly
DB_READONLY_PASSWORD=

# Database TLS: disable (local) | require (Supabase) | verify (+ PG_SSL_CA_FILE=path to CA certificate)
PG_SSL=disable

# ---------- MCP server ----------
PORT=3000
# Host headers the server accepts (DNS-rebinding protection). Add your ngrok host when testing in ChatGPT.
ALLOWED_HOSTS=localhost,127.0.0.1
# Saada Hisaab stores timestamps in UTC; reports use the business's local day boundaries.
BUSINESS_TIMEZONE=Asia/Karachi
CURRENCY=PKR

# ---------- OAuth sign-in (how ChatGPT users connect) ----------
# Signs client IDs, codes and tokens (32+ random characters). Changing it signs everyone out.
OAUTH_SECRET=
# dev = any Saada Hisaab username + DEV_LOGIN_PASSWORD (dummy data only); api = Saada Hisaab login API
LOGIN_MODE=api
SAADA_LOGIN_API_URL=https://demoapi.sadahisab.com/api/auth/login
# id (production: same database as the login API) | username (demo: the login API uses another database copy)
LOGIN_MATCH_BY=username
DEV_LOGIN_PASSWORD=
# Public address (OAuth issuer). Optional: defaults to Render's URL, else http://localhost:PORT
PUBLIC_BASE_URL=

# ---------- Optional dev shortcut without sign-in ----------
# When both are set, /mcp/<DEV_ACCESS_KEY> acts as DEV_USERNAME. Leave empty to disable.
DEV_USERNAME=
DEV_ACCESS_KEY=
